---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <meta name="description" content="A real-time crossword tile race for two to eight players." />
  <meta name="theme-color" content="#ffd51f" />
  <link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png" />
  <link rel="apple-touch-icon" href="./icons/apple-touch-icon.png" />
  <link rel="manifest" href="./manifest.webmanifest" />
  <title>Tiles</title>
</head>
<body class="standalone-page">
  <main id="tiles" class="tiles" data-connection="online">
    <section class="entry-card" data-view="name">
      <div class="brand-mark" aria-label="Tiles"><span>T</span><span>I</span><span>L</span><span>E</span><span>S</span></div>
      <label class="player-name-field" for="player-name">
        <span>Player name</span>
        <input id="player-name" data-name-input form="online-game-form" maxlength="18" autocomplete="nickname" required />
      </label>
      <div class="home-options" data-home-options>
        <form id="online-game-form" class="play-option online-option" data-name-form>
          <div class="option-heading"><span>Online</span><h2>Play online</h2></div>
          <p>Start a private game and invite players with a link or QR code.</p>
          <button class="online-start" type="submit" data-enter-lobby>Create online game</button>
          <p class="room-note" data-room-note>Uses an internet connection · 2–8 players</p>
        </form>
        <div class="play-option nearby-entry" data-nearby-entry hidden>
          <div class="option-heading"><span>Offline</span><h2>Play nearby</h2></div>
          <p>Invite players around you directly over Bluetooth and Wi-Fi.</p>
          <strong class="nearby-label">Local players</strong>
          <div class="nearby-endpoints" data-nearby-endpoints>
            <div class="nearby-search"><span aria-hidden="true">…</span><p>Searching nearby…</p></div>
          </div>
          <button type="button" class="nearby-start" data-nearby-start hidden>Request game</button>
          <small data-nearby-status hidden></small>
        </div>
        <section class="saved-games" data-saved-games hidden>
          <p class="eyebrow">Saved on this device</p>
          <h2>Continue a game</h2>
          <div class="saved-game-list" data-saved-game-list></div>
        </section>
      </div>
    </section>

    <section class="lobby-card" data-view="lobby" hidden>
      <header>
        <div>
          <p class="eyebrow">Room <span data-room-label></span></p>
          <h1 data-lobby-title>Waiting for the bunch</h1>
        </div>
        <div class="lobby-nav">
          <button type="button" data-lobby-back>← Back</button>
          <span class="live-pill">Live</span>
        </div>
      </header>
      <ol class="roster" data-roster></ol>
      <section class="lobby-chat" aria-label="Lobby chat">
        <div class="chat-heading"><strong>Lobby chat</strong><span>Visible to everyone here</span></div>
        <div class="chat-log" data-chat-log role="log" aria-live="polite">
          <p data-chat-empty>No messages yet.</p>
        </div>
        <form class="chat-form" data-chat-form>
          <input data-chat-input maxlength="240" autocomplete="off" placeholder="Message the lobby…" aria-label="Lobby message" />
          <button type="submit" data-chat-send>Send</button>
        </form>
      </section>
      <label class="dictionary-picker">
        <span>Game dictionary</span>
        <select data-dictionary>
          <option value="scowl-us">SCOWL · American English</option>
          <option value="scowl-gb" selected>SCOWL · British English</option>
          <option value="de">Deutsch · German</option>
          <option value="es">Español · Spanish</option>
          <option value="it">Italiano · Italian</option>
          <option value="fr">Français · French</option>
          <option value="pt">Português · Portuguese</option>
        </select>
      </label>
      <div class="lobby-invite" data-online-invite>
        <div class="qr-frame">
          <canvas data-room-qr width="164" height="164" role="img" aria-label="QR code for this private game link"></canvas>
        </div>
        <div class="invite-copy">
          <p class="eyebrow">Invite players</p>
          <h2>Scan to join</h2>
          <p>Point another phone’s camera at the code.</p>
          <div class="invite-actions">
            <button class="copy-action" type="button" data-copy-link>Copy link</button>
            <button class="share-action" type="button" data-share>Share</button>
          </div>
        </div>
      </div>
      <div class="lobby-actions">
        <button class="primary-action" type="button" data-start disabled>Waiting for an opponent…</button>
      </div>
      <p class="lobby-help">Share the private link to invite up to seven other players. The host chooses the dictionary for everyone.</p>
    </section>

    <section class="game-shell" data-view="game" hidden>
      <header class="game-bar">
        <div class="compact-brand"><span>TS</span><strong>Tiles</strong></div>
        <div class="players-scroll" data-player-scroll>
          <ul class="top-players" data-players aria-label="Players"></ul>
        </div>
        <dl>
          <div><dt>Bunch</dt><dd data-bunch>0</dd></div>
          <div><dt>Peels</dt><dd data-peel>0</dd></div>
          <div><dt>Dumps</dt><dd data-dumps>0</dd></div>
        </dl>
      </header>
      <div class="player-disconnect-notice" data-player-disconnect role="status" aria-live="polite" hidden></div>
      <div class="play-layout">
        <div class="board" data-board aria-label="Shared crossword table">
          <div class="board-layer" data-board-layer>
            <div class="board-origin" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <section class="rack-wrap" aria-label="Loose tiles">
        <div class="rack" data-rack></div>
        <div class="rack-actions">
          <button type="button" class="menu-button" data-game-menu-open>Menu</button>
          <button type="button" class="randomise-button" data-randomise disabled>Mix</button>
          <button type="button" class="flip-button" data-flip-word>Flip</button>
          <button type="button" class="direction-button" data-fill-direction aria-label="Autofill right">Fill →</button>
          <button type="button" class="dump-button" data-dump disabled>Dump</button>
          <button type="button" class="history-button" data-redo disabled>Redo</button>
          <button type="button" class="history-button" data-undo disabled>Undo</button>
        </div>
      </section>
    </section>

    <dialog class="game-menu-dialog" data-game-menu>
      <button type="button" class="dialog-close" data-game-menu-close aria-label="Close">×</button>
      <p class="eyebrow">Game options</p>
      <h2>Menu</h2>
      <div class="game-menu-actions">
        <button type="button" class="new-game-action" data-new-game>
          <strong>New game</strong>
          <span>Reshuffle and redeal fresh tiles for everyone.</span>
        </button>
        <button type="button" class="bug-report-action" data-bug-report>
          <strong>Save bug report</strong>
          <span>Share connection and game diagnostics for debugging.</span>
        </button>
        <button type="button" class="home-action" data-go-home>
          <strong>Back to home</strong>
          <span>Leave this game and return to the start screen.</span>
        </button>
      </div>
    </dialog>

    <div class="peel-animation" data-peel-animation aria-hidden="true"><span>🍌</span><strong>PEEL!</strong></div>

    <dialog class="invite-dialog" data-invite-dialog>
      <p class="eyebrow">Local game invitation</p>
      <h2><span data-invite-name>A nearby player</span> invited you to play</h2>
      <p>Join their local Tiles lobby?</p>
      <div class="invite-dialog-actions">
        <button type="button" data-invite-decline>Decline</button>
        <button type="button" class="primary-action" data-invite-accept>Accept</button>
      </div>
    </dialog>

    <div class="update-notice" data-update-notice role="status" hidden>
      <span>A new version of Tiles is ready.</span>
      <button type="button" data-update-now>Update now</button>
    </div>
    <div class="connection-notice" data-connection-notice role="alert" hidden>
      <span data-connection-message>Connection lost.</span>
      <button type="button" data-retry-connection>Retry now</button>
    </div>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
  </main>

  <footer class="game-credit">
    Gameplay follows the classic rules for Bananagrams, a trademark of Bananagrams, Inc. This independent fan project is not affiliated with or endorsed by Bananagrams.
    <a href="https://bananagrams.com/pages/instructions" target="_blank" rel="noopener">Official rules</a>
  </footer>
</body>
</html>

<style is:global>
  :root { --tr-yellow: #ffd51f; --tr-ink: #17150f; --tr-cream: #fff9df; --tr-coral: #ff664d; --tr-green: #19734b; }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { width: 100%; min-height: 100%; margin: 0; overflow-x: hidden; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body.standalone-page { background: #efe6bf; }
  .tiles { display: flow-root; width: 100%; max-width: none; min-height: 100vh; min-height: 100dvh; margin: 0; padding: 0; background: #efe6bf; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: var(--tr-ink); }
  .entry-card, .lobby-card { width: min(600px, calc(100% - 2rem)); margin: clamp(2rem, 10vh, 6rem) auto; background: var(--tr-cream); border: 3px solid var(--tr-ink); border-radius: 24px; padding: clamp(1.5rem, 5vw, 3.5rem); box-shadow: 10px 10px 0 var(--tr-ink); }
  .brand-mark { display: flex; gap: .35rem; transform: rotate(-2deg); margin-bottom: 1.5rem; }
  .brand-mark span, .compact-brand span { display: grid; place-items: center; width: 2.6rem; aspect-ratio: 1; background: var(--tr-yellow); border: 2px solid var(--tr-ink); border-radius: 7px; font: 800 1.4rem/1 Georgia, serif; box-shadow: 3px 3px 0 var(--tr-ink); }
  .eyebrow { margin: 0 0 .5rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 800; font-size: .78rem; }
  .tiles h1 { margin: 0; font: 900 clamp(2.8rem, 8vw, 5rem)/.9 Georgia, serif; letter-spacing: -.06em; }
  .play-option { padding: 1rem; border: 2px solid var(--tr-ink); border-radius: 14px; }
  .play-option + .play-option { margin-top: .9rem; }
  .online-option { background: #fff; }
  .nearby-entry { background: #edf8ff; text-align: left; }
  .option-heading { display: flex; align-items: center; gap: .65rem; margin-bottom: .35rem; }
  .option-heading span { flex: 0 0 auto; padding: .3rem .55rem; border: 1.5px solid var(--tr-ink); border-radius: 999px; background: #d7eaff; font-size: .7rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .nearby-entry .option-heading span { background: #d8f8e3; }
  .option-heading h2 { margin: 0; font: 900 1.55rem/1 Georgia, serif; }
  .play-option > p { margin: .45rem 0 .9rem; color: #6b6044; font-size: .84rem; line-height: 1.4; }
  .tiles label { display: block; margin-bottom: .45rem; font-weight: 800; }
  .player-name-field { display: grid !important; gap: .45rem; margin: 0 0 1rem; }
  .player-name-field span { font-weight: 800; }
  .player-name-field input, .online-start, .primary-action, .dump-button, .menu-button { min-height: 3.2rem; border: 2px solid var(--tr-ink); border-radius: 10px; font: 800 1rem/1 inherit; }
  .player-name-field input { width: 100%; min-width: 0; padding: .7rem .9rem; background: #fff; color: var(--tr-ink); caret-color: var(--tr-ink); }
  .online-start, .primary-action { width: 100%; padding: .7rem 1.1rem; background: var(--tr-yellow); color: var(--tr-ink); box-shadow: 3px 3px 0 var(--tr-ink); cursor: pointer; }
  .home-options { max-height: 0; opacity: 0; visibility: hidden; overflow: hidden; transform: translateY(12px); pointer-events: none; transition: max-height .45s ease, opacity .25s ease, transform .3s ease, visibility 0s linear .45s; }
  .home-options.is-ready { max-height: 1600px; opacity: 1; visibility: visible; overflow: visible; transform: none; pointer-events: auto; transition-delay: 0s; }
  .home-options.is-ready > * { animation: home-option-in .32s ease both; }
  .home-options.is-ready > :nth-child(2) { animation-delay: .06s; }
  .home-options.is-ready > :nth-child(3) { animation-delay: .12s; }
  @keyframes home-option-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .saved-games { margin-top: 1.35rem; padding-top: 1.2rem; border-top: 2px solid var(--tr-ink); }
  .saved-games[hidden] { display: none; }
  .saved-games h2 { margin: .2rem 0 .75rem; font: 900 1.6rem/1 Georgia, serif; }
  .saved-game-list { display: grid; gap: .6rem; }
  .saved-game { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .55rem; }
  .saved-game-open, .saved-game-forget { border: 2px solid var(--tr-ink); border-radius: 9px; color: var(--tr-ink); box-shadow: 2px 2px 0 var(--tr-ink); cursor: pointer; }
  .saved-game-open { min-width: 0; padding: .75rem; background: #fff; text-align: left; }
  .saved-game-open strong, .saved-game-open span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .saved-game-open strong { margin-bottom: .25rem; font-size: .95rem; }
  .saved-game-open span { color: #6b6044; font-size: .76rem; }
  .saved-game-forget { width: 2.75rem; background: var(--tr-cream); font-size: 1.2rem; }
  .room-note, .lobby-help { margin: 1rem 0 0; color: #6b6044; font-size: .88rem; }
  .nearby-label { display: block; margin-bottom: .55rem; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; }
  .nearby-entry small { display: block; margin-top: .55rem; color: #6b6044; font-size: .74rem; line-height: 1.35; }
  .nearby-entry small[hidden], .nearby-start[hidden] { display: none; }
  .nearby-entry button { min-height: 2.8rem; border: 2px solid var(--tr-ink); border-radius: 9px; color: var(--tr-ink); box-shadow: 2px 2px 0 var(--tr-ink); font-weight: 800; cursor: pointer; }
  .nearby-entry button:disabled { opacity: .5; box-shadow: none; cursor: default; }
  .nearby-start { width: 100%; margin-top: .65rem; background: var(--tr-yellow); }
  .nearby-endpoints { display: flex; flex-wrap: wrap; gap: .5rem; }
  .nearby-player { display: inline-flex; width: fit-content; max-width: 100%; align-items: center; gap: .55rem; min-height: 2.8rem; padding: .65rem .75rem; border: 2px solid var(--tr-ink); border-radius: 9px; background: #fff; box-shadow: 2px 2px 0 var(--tr-ink); font-weight: 800; cursor: pointer; }
  .nearby-player:has(input:checked) { background: #fff6bf; }
  .nearby-player input { width: 1.25rem; height: 1.25rem; flex: 0 0 auto; margin: 0; accent-color: #19734b; }
  .nearby-player span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nearby-search { display: grid; width: 100%; justify-items: center; gap: .65rem; padding: 1rem 0 .35rem; color: #6b6044; }
  .nearby-search span { display: grid; place-items: center; width: 3rem; aspect-ratio: 1; border: 2px solid var(--tr-ink); border-radius: 7px; background: var(--tr-yellow); color: var(--tr-ink); box-shadow: 3px 3px 0 var(--tr-ink); font: 900 1.6rem/1 Georgia, serif; animation: nearby-tile-spin 1.4s steps(4, end) infinite; }
  .nearby-search p { margin: 0; font-size: .82rem; font-weight: 700; }
  @keyframes nearby-tile-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .lobby-card header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .lobby-card header > div { min-width: 0; }
  .lobby-card h1 { font-size: clamp(2.3rem, 7vw, 4rem); }
  .lobby-nav { flex: 0 0 auto; display: flex; align-items: center; gap: .45rem; }
  .lobby-nav button { min-height: 2.2rem; padding: .35rem .6rem; border: 2px solid var(--tr-ink); border-radius: 999px; background: #fff; color: var(--tr-ink); font: 800 .78rem/1 inherit; cursor: pointer; }
  .live-pill { flex: 0 0 auto; border: 2px solid var(--tr-ink); background: #c8ffcf; border-radius: 999px; padding: .35rem .7rem; font-weight: 800; }
  .roster { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: .55rem; }
  .roster li { display: flex; align-items: center; gap: .7rem; padding: .8rem; background: #fff; border: 2px solid var(--tr-ink); border-radius: 10px; }
  .roster li.is-loading { color: #6b6044; }
  .roster li.is-loading::before { content: ''; width: 1rem; height: 1rem; flex: 0 0 auto; border: 2px solid #b4aa88; border-top-color: var(--tr-ink); border-radius: 50%; animation: button-spin .7s linear infinite; }
  .roster-player { min-width: 0; flex: 1 1 9rem; display: grid; gap: .16rem; }
  .roster-player strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .transport-detail { color: #6b6044; font-size: .68rem; font-weight: 700; line-height: 1.25; }
  .transport-detail.searching,
  .transport-detail.requesting,
  .transport-detail.requested,
  .transport-detail.authenticating,
  .transport-detail.transport,
  .transport-detail.syncing { color: #765b00; }
  .transport-detail.synced { color: #19734b; }
  .transport-detail.disconnected,
  .transport-detail.failed { color: #a43124; }
  .roster em { margin-left: auto; font-size: .75rem; font-style: normal; text-transform: uppercase; }
  .reinvite-player { flex: 0 0 auto; min-height: 2rem; padding: .35rem .6rem; border: 1.5px solid var(--tr-ink); border-radius: 7px; background: var(--tr-yellow); color: var(--tr-ink); box-shadow: 1px 1px 0 var(--tr-ink); font: 800 .72rem/1 inherit; cursor: pointer; }
  .reinvite-player:disabled { background: #ded8bd; opacity: .7; box-shadow: none; cursor: default; }
  .invite-state { padding: .25rem .45rem; border-radius: 999px; background: #e8e1c8; color: #5f5845; }
  .invite-state.received { background: #d7eaff; color: #24527d; }
  .invite-state.accepted { background: #d8f8e3; color: #17613d; }
  .presence { width: .7rem; height: .7rem; border-radius: 50%; background: #2bb36c; box-shadow: 0 0 0 3px #ccf4dd; }
  .presence.invite-pending { background: #d0a900; box-shadow: 0 0 0 3px #fff1a5; }
  .presence.is-offline { background: #99917a; box-shadow: 0 0 0 3px #e4deca; }
  .lobby-chat { margin: -1rem 0 1rem; border: 2px solid var(--tr-ink); border-radius: 12px; background: #fff; overflow: hidden; }
  .chat-heading { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; padding: .65rem .75rem; border-bottom: 1.5px solid var(--tr-ink); background: #fff6bf; }
  .chat-heading strong { font-size: .86rem; }
  .chat-heading span { color: #6b6044; font-size: .68rem; }
  .chat-log { height: 116px; overflow-y: auto; padding: .65rem .75rem; display: grid; align-content: start; gap: .45rem; }
  .chat-log > p { margin: 0; color: #8a8064; font-size: .78rem; }
  .chat-message { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: .2rem .45rem; font-size: .8rem; }
  .chat-message strong { color: #4c432e; }
  .chat-message span { overflow-wrap: anywhere; }
  .chat-message time { color: #92876a; font-size: .62rem; }
  .chat-message.is-you strong { color: #8a5400; }
  .chat-receipt { grid-column: 2 / -1; color: #7d7359; font-size: .62rem; font-weight: 800; text-align: right; }
  .chat-receipt[data-status="read"] { color: #19734b; }
  .chat-receipt[data-status="not-delivered"] { color: #b23a2c; }
  .chat-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .45rem; padding: .55rem; border-top: 1.5px solid var(--tr-ink); }
  .chat-form input { min-width: 0; min-height: 2.5rem; padding: .55rem .65rem; border: 1.5px solid var(--tr-ink); border-radius: 8px; color: var(--tr-ink); font: 500 .85rem/1 inherit; }
  .chat-form button { min-height: 2.5rem; padding: .55rem .75rem; border: 1.5px solid var(--tr-ink); border-radius: 8px; background: var(--tr-yellow); color: var(--tr-ink); box-shadow: 2px 2px 0 var(--tr-ink); font-weight: 800; cursor: pointer; }
  .dictionary-picker { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: .75rem; margin: 0 0 1rem; padding: .7rem; border: 2px solid var(--tr-ink); border-radius: 10px; background: #fff; }
  .dictionary-picker span { font-weight: 800; }
  .dictionary-picker select { min-width: 0; padding: .55rem; border: 1.5px solid var(--tr-ink); border-radius: 7px; background: #fffdf3; color: var(--tr-ink); font: 700 .9rem/1 inherit; }
  .dictionary-picker select:disabled { opacity: .7; }
  .primary-action { width: 100%; }
  .primary-action:disabled { background: #ded8bd; color: #77705b; box-shadow: none; cursor: default; }
  .lobby-invite { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: center; margin-bottom: 1rem; padding: .85rem; border: 2px solid var(--tr-ink); border-radius: 14px; background: #fff; }
  .lobby-invite[hidden] { display: none; }
  .qr-frame { padding: .35rem; border: 2px solid var(--tr-ink); border-radius: 10px; background: #fffdf3; }
  .qr-frame canvas { display: block; width: 132px; height: 132px; }
  .invite-copy h2 { margin: 0; font: 900 1.75rem/1 Georgia, serif; letter-spacing: -.03em; }
  .invite-copy > p:not(.eyebrow) { margin: .5rem 0 .8rem; color: #6b6044; font-size: .88rem; line-height: 1.35; }
  .invite-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .copy-action, .share-action { min-height: 2.8rem; padding: .6rem .75rem; border: 2px solid var(--tr-ink); border-radius: 9px; color: var(--tr-ink); box-shadow: 2px 2px 0 var(--tr-ink); font: 800 .9rem/1 inherit; cursor: pointer; }
  .copy-action { background: var(--tr-yellow); }
  .share-action { background: #fff; }
  .lobby-actions { display: grid; gap: .65rem; }
  .game-shell { position: fixed; inset: 0; min-width: 0; min-height: 0; display: grid; grid-template-rows: max-content max-content minmax(0, 1fr) max-content; background: var(--tr-cream); overflow: hidden; }
  .game-shell[hidden], .entry-card[hidden], .lobby-card[hidden] { display: none; }
  .game-bar { grid-row: 1; min-width: 0; min-height: 48px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .55rem; padding: max(.35rem, env(safe-area-inset-top)) max(.6rem, env(safe-area-inset-right)) .35rem max(.6rem, env(safe-area-inset-left)); border-bottom: 2px solid var(--tr-ink); background: var(--tr-yellow); }
  .compact-brand { display: flex; align-items: center; gap: .75rem; font-family: Georgia, serif; }
