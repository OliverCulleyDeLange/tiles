---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="A real-time crossword tile race for two to eight players." />
  <meta name="theme-color" content="#ffd51f" />
  <title>Tiles</title>
</head>
<body class="standalone-page">
  <main id="tiles" class="tiles" data-connection="online">
    <section class="entry-card" data-view="name">
      <div class="brand-mark" aria-hidden="true"><span>T</span><span>I</span><span>L</span><span>E</span></div>
      <p class="eyebrow">Real-time word race</p>
      <h1>Tiles</h1>
      <p class="intro">Build a crossword before everyone else. No turns. No waiting.</p>
      <form data-name-form>
        <label for="player-name">Player name</label>
        <div class="name-row">
          <input id="player-name" data-name-input maxlength="18" autocomplete="nickname" required autofocus />
          <button type="submit" data-enter-lobby>Create lobby</button>
        </div>
      </form>
      <div class="nearby-entry" data-nearby-entry hidden>
        <span>or play with devices nearby</span>
        <div>
          <button type="button" data-nearby-host>Host nearby</button>
          <button type="button" data-nearby-join>Join nearby</button>
        </div>
      </div>
      <p class="room-note" data-room-note>A private room link will be created · 2–8 players</p>
    </section>

    <section class="lobby-card" data-view="lobby" hidden>
      <header>
        <div>
          <p class="eyebrow">Room <span data-room-label></span></p>
          <h1>Waiting for the bunch</h1>
        </div>
        <span class="live-pill">Live</span>
      </header>
      <ol class="roster" data-roster></ol>
      <label class="dictionary-picker">
        <span>Game dictionary</span>
        <select data-dictionary>
          <option value="scowl-us">SCOWL · American English</option>
          <option value="scowl-gb">SCOWL · British English</option>
        </select>
      </label>
      <div class="lobby-invite" data-online-invite>
        <div class="qr-frame">
          <canvas data-room-qr width="164" height="164" role="img" aria-label="QR code for this private game link"></canvas>
        </div>
        <div class="invite-copy">
          <p class="eyebrow">Invite players</p>
          <h2>Scan to join</h2>
          <p>Point another phone’s camera at the code.</p>
          <div class="invite-actions">
            <button class="copy-action" type="button" data-copy-link>Copy link</button>
            <button class="share-action" type="button" data-share>Share</button>
          </div>
        </div>
      </div>
      <div class="lobby-actions">
        <button class="primary-action" type="button" data-start disabled>Waiting for an opponent…</button>
      </div>
      <p class="lobby-help">Share the private link to invite up to seven other players. The host chooses the dictionary for everyone.</p>
    </section>

    <section class="game-shell" data-view="game" hidden>
      <header class="game-bar">
        <div class="compact-brand"><span>TS</span><strong>Tiles</strong></div>
        <ul class="top-players" data-players aria-label="Players"></ul>
        <dl>
          <div><dt>Bunch</dt><dd data-bunch>0</dd></div>
          <div><dt>Peels</dt><dd data-peel>0</dd></div>
        </dl>
      </header>
      <div class="play-layout">
        <div class="board" data-board aria-label="Shared crossword table">
          <div class="board-label" data-board-label>Shared table</div>
          <div class="board-controls" data-board-controls aria-label="Table view controls">
            <button type="button" data-rotate-left aria-label="Rotate table left">↶</button>
            <button type="button" data-reset-view aria-label="Reset table view">⌾</button>
            <button type="button" data-rotate-right aria-label="Rotate table right">↷</button>
          </div>
          <div class="board-layer" data-board-layer>
            <div class="board-origin" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <section class="rack-wrap" aria-label="Loose tiles">
        <div class="rack" data-rack></div>
        <button type="button" class="dump-button" data-dump disabled>Dump</button>
      </section>
    </section>

    <dialog class="review-dialog" data-review>
      <p class="eyebrow">Final check</p>
      <h2 data-review-title>BANANAS!</h2>
      <p>Check every word. Proper nouns, abbreviations and misspellings are rotten.</p>
      <div class="review-board" data-review-board></div>
      <div class="review-actions">
        <button type="button" data-review-rotten class="rotten">Rotten Banana</button>
        <button type="button" data-review-accept class="accept">Looks good</button>
      </div>
    </dialog>

    <dialog class="nearby-dialog" data-nearby-dialog>
      <button type="button" class="dialog-close" data-nearby-close aria-label="Close">×</button>
      <p class="eyebrow">Offline nearby play</p>
      <h2 data-nearby-title>Finding games…</h2>
      <p data-nearby-status>Keep Bluetooth and Wi-Fi enabled.</p>
      <div class="nearby-endpoints" data-nearby-endpoints></div>
      <div class="nearby-verification" data-nearby-verification hidden>
        <p>Confirm that this code appears on both devices:</p>
        <strong data-nearby-code></strong>
        <div>
          <button type="button" data-nearby-reject>Reject</button>
          <button type="button" data-nearby-accept>Connect</button>
        </div>
      </div>
    </dialog>

    <div class="update-notice" data-update-notice role="status" hidden>
      <span>A new version of Tiles is ready.</span>
      <button type="button" data-update-now>Update now</button>
    </div>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
  </main>

  <footer class="game-credit">
    Gameplay follows the classic rules for Bananagrams, a trademark of Bananagrams, Inc. This independent fan project is not affiliated with or endorsed by Bananagrams.
    <a href="https://bananagrams.com/pages/instructions" target="_blank" rel="noopener">Official rules</a>
  </footer>
</body>
</html>

<style is:global>
  :root { --tr-yellow: #ffd51f; --tr-ink: #17150f; --tr-cream: #fff9df; --tr-coral: #ff664d; --tr-green: #19734b; }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { width: 100%; min-height: 100%; margin: 0; overflow-x: hidden; }
  body.standalone-page { background: #efe6bf; }
  .tiles { display: flow-root; width: 100%; max-width: none; min-height: 100vh; min-height: 100dvh; margin: 0; padding: 0; background: #efe6bf; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: var(--tr-ink); }
  .entry-card, .lobby-card { width: min(600px, calc(100% - 2rem)); margin: clamp(2rem, 10vh, 6rem) auto; background: var(--tr-cream); border: 3px solid var(--tr-ink); border-radius: 24px; padding: clamp(1.5rem, 5vw, 3.5rem); box-shadow: 10px 10px 0 var(--tr-ink); }
  .brand-mark { display: flex; gap: .35rem; transform: rotate(-2deg); margin-bottom: 1.5rem; }
  .brand-mark span, .compact-brand span { display: grid; place-items: center; width: 2.6rem; aspect-ratio: 1; background: var(--tr-yellow); border: 2px solid var(--tr-ink); border-radius: 7px; font: 800 1.4rem/1 Georgia, serif; box-shadow: 3px 3px 0 var(--tr-ink); }
  .eyebrow { margin: 0 0 .5rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 800; font-size: .78rem; }
  .tiles h1 { margin: 0; font: 900 clamp(2.8rem, 8vw, 5rem)/.9 Georgia, serif; letter-spacing: -.06em; }
  .intro { max-width: 27rem; font-size: 1.15rem; line-height: 1.5; }
  .tiles label { display: block; margin-bottom: .45rem; font-weight: 800; }
  .name-row { display: grid; grid-template-columns: 1fr auto; gap: .6rem; }
  .name-row input, .name-row button, .primary-action, .dump-button, .review-actions button { min-height: 3.2rem; border: 2px solid var(--tr-ink); border-radius: 10px; font: 800 1rem/1 inherit; }
  .name-row input { min-width: 0; padding: .7rem .9rem; background: #fff; color: var(--tr-ink); caret-color: var(--tr-ink); }
  .name-row button, .primary-action { padding: .7rem 1.1rem; background: var(--tr-yellow); color: var(--tr-ink); box-shadow: 3px 3px 0 var(--tr-ink); cursor: pointer; }
  .room-note, .lobby-help { margin: 1rem 0 0; color: #6b6044; font-size: .88rem; }
  .nearby-entry { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #c8bb8e; text-align: center; }
  .nearby-entry > span { display: block; margin-bottom: .55rem; color: #6b6044; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .nearby-entry > div { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .nearby-entry button { min-height: 2.8rem; border: 2px solid var(--tr-ink); border-radius: 9px; background: #fff; color: var(--tr-ink); box-shadow: 2px 2px 0 var(--tr-ink); font-weight: 800; }
  .lobby-card header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .lobby-card h1 { font-size: clamp(2.3rem, 7vw, 4rem); }
  .live-pill { border: 2px solid var(--tr-ink); background: #c8ffcf; border-radius: 999px; padding: .35rem .7rem; font-weight: 800; }
  .roster { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: .55rem; }
  .roster li { display: flex; align-items: center; gap: .7rem; padding: .8rem; background: #fff; border: 2px solid var(--tr-ink); border-radius: 10px; }
  .roster em { margin-left: auto; font-size: .75rem; font-style: normal; text-transform: uppercase; }
  .presence { width: .7rem; height: .7rem; border-radius: 50%; background: #2bb36c; box-shadow: 0 0 0 3px #ccf4dd; }
  .presence.is-offline { background: #99917a; box-shadow: 0 0 0 3px #e4deca; }
  .dictionary-picker { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: .75rem; margin: 0 0 1rem; padding: .7rem; border: 2px solid var(--tr-ink); border-radius: 10px; background: #fff; }
  .dictionary-picker span { font-weight: 800; }
  .dictionary-picker select { min-width: 0; padding: .55rem; border: 1.5px solid var(--tr-ink); border-radius: 7px; background: #fffdf3; color: var(--tr-ink); font: 700 .9rem/1 inherit; }
  .dictionary-picker select:disabled { opacity: .7; }
  .primary-action { width: 100%; }
  .primary-action:disabled { background: #ded8bd; color: #77705b; box-shadow: none; cursor: default; }
  .lobby-invite { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: center; margin-bottom: 1rem; padding: .85rem; border: 2px solid var(--tr-ink); border-radius: 14px; background: #fff; }
  .lobby-invite[hidden] { display: none; }
  .qr-frame { padding: .35rem; border: 2px solid var(--tr-ink); border-radius: 10px; background: #fffdf3; }
  .qr-frame canvas { display: block; width: 132px; height: 132px; }
  .invite-copy h2 { margin: 0; font: 900 1.75rem/1 Georgia, serif; letter-spacing: -.03em; }
  .invite-copy > p:not(.eyebrow) { margin: .5rem 0 .8rem; color: #6b6044; font-size: .88rem; line-height: 1.35; }
  .invite-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .copy-action, .share-action { min-height: 2.8rem; padding: .6rem .75rem; border: 2px solid var(--tr-ink); border-radius: 9px; color: var(--tr-ink); box-shadow: 2px 2px 0 var(--tr-ink); font: 800 .9rem/1 inherit; cursor: pointer; }
  .copy-action { background: var(--tr-yellow); }
  .share-action { background: #fff; }
  .lobby-actions { display: grid; gap: .65rem; }
  .game-shell { position: fixed; inset: 0; width: 100%; height: 100vh; height: 100dvh; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: var(--tr-cream); overflow: hidden; }
  .game-shell[hidden], .entry-card[hidden], .lobby-card[hidden] { display: none; }
  .game-bar { min-width: 0; min-height: 48px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .55rem; padding: max(.35rem, env(safe-area-inset-top)) max(.6rem, env(safe-area-inset-right)) .35rem max(.6rem, env(safe-area-inset-left)); border-bottom: 2px solid var(--tr-ink); background: var(--tr-yellow); }
  .compact-brand { display: flex; align-items: center; gap: .75rem; font-family: Georgia, serif; }
  .compact-brand span { width: 2rem; background: #fff6bf; font-size: .72rem; box-shadow: 2px 2px 0 var(--tr-ink); }
  .compact-brand strong { font-size: .88rem; }
  .game-bar dl { display: flex; gap: .35rem; margin: 0; }
  .game-bar dl div { min-width: 46px; text-align: center; border: 1.5px solid var(--tr-ink); border-radius: 7px; background: #fff6bf; padding: .18rem .35rem; }
  .game-bar dt { font-size: .55rem; text-transform: uppercase; font-weight: 800; }
  .game-bar dd { margin: 0; font: 800 1rem/1 Georgia, serif; }
  .top-players { min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; gap: .3rem; overflow-x: auto; scrollbar-width: thin; }
  .top-players li { flex: 0 0 auto; }
  .dump-button { min-height: 2.25rem; padding: .3rem .65rem; border-width: 1.5px; border-radius: 7px; background: var(--tr-coral); color: #fff; cursor: pointer; box-shadow: 2px 2px 0 var(--tr-ink); font-size: .76rem; }
  .dump-button small { display: block; font-size: .65rem; text-transform: uppercase; }
  .dump-button:disabled { opacity: .42; cursor: default; box-shadow: none; }
  .play-layout { min-height: 0; }
  .player-chip { min-height: 28px; display: flex; align-items: center; gap: .35rem; border: 1.5px solid var(--tr-ink); border-radius: 999px; background: #fff; color: var(--tr-ink); padding: .18rem .55rem; font: 700 .72rem/1 inherit; }
  .player-chip.is-you { background: var(--tr-yellow); }
  .player-chip.is-out { opacity: .45; }
  .player-chip i { width: .65rem; height: .65rem; flex: 0 0 auto; border: 1px solid var(--tr-ink); border-radius: 50%; background: var(--owner-color); }
  .player-chip b { font-size: .62rem; text-transform: uppercase; }
  .board { position: relative; overflow: hidden; width: 100%; height: 100%; min-width: 0; min-height: 0; cursor: grab; background: #d9cba8; touch-action: none; overscroll-behavior: contain; }
  .board.is-panning { cursor: grabbing; }
  .board-layer { position: absolute; left: 50%; top: 50%; width: 4800px; height: 4800px; margin: -2400px 0 0 -2400px; transform-origin: 50% 50%; background-color: #eee4c5; background-image: radial-gradient(ellipse at center, rgba(255,251,229,.92) 0%, rgba(238,228,197,.48) 48%, rgba(196,177,132,.28) 100%), radial-gradient(circle at 22% 31%, rgba(113,91,49,.13) 0 1.2px, transparent 1.8px), radial-gradient(circle at 71% 63%, rgba(255,255,255,.52) 0 1.4px, transparent 2px), radial-gradient(circle at 43% 78%, rgba(130,101,54,.09) 0 1px, transparent 1.7px); background-size: 100% 100%, 37px 41px, 53px 47px, 61px 59px; will-change: transform; }
  .board-label { position: absolute; z-index: 5; top: .45rem; left: .5rem; padding: .25rem .5rem; border: 1px solid #b9ad87; border-radius: 999px; background: rgba(255,249,223,.86); color: #5d543d; font-size: .68rem; font-weight: 800; pointer-events: none; }
  .board-controls { position: absolute; z-index: 6; top: .42rem; right: .5rem; display: flex; gap: .25rem; }
  .board-controls button { display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0; border: 1.5px solid var(--tr-ink); border-radius: 50%; background: rgba(255,253,243,.94); color: var(--tr-ink); box-shadow: 1px 1px 0 var(--tr-ink); font: 900 1rem/1 sans-serif; cursor: pointer; touch-action: manipulation; }
  .board-controls button:active { translate: 1px 1px; box-shadow: none; }
  .board-origin { position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; transform: translate(-50%, -50%); border-radius: 50%; background: var(--tr-coral); opacity: .4; }
  .player-area { position: absolute; z-index: 1; box-sizing: border-box; border: 5px solid var(--owner-color); border-radius: 22px; background: color-mix(in srgb, var(--owner-color) 8%, transparent); box-shadow: inset 0 0 0 2px rgba(255,255,255,.7); pointer-events: none; }
  .player-area.is-you { background: color-mix(in srgb, var(--owner-color) 14%, transparent); }
  .player-area > span { position: absolute; top: .45rem; left: .65rem; padding: .3rem .55rem; border: 2px solid var(--owner-color); border-radius: 999px; background: rgba(255,253,243,.94); color: var(--tr-ink); font: 900 .72rem/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .04em; text-transform: uppercase; }
  .letter-tile { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 2px solid var(--tr-ink); border-radius: 6px; background: #fffdf3; color: var(--tr-ink); box-shadow: inset 0 -5px 0 var(--owner-color), 3px 3px 0 #8b7c54; font: 800 1.45rem/1 Georgia, serif; cursor: grab; user-select: none; touch-action: none; transform: rotate(var(--tile-rotation, 0rad)); }
  .board-layer > .letter-tile { position: absolute; z-index: 2; }
  .letter-tile.is-spectating { cursor: default; }
  .letter-tile.is-selected { outline: 4px solid var(--tr-coral); outline-offset: 2px; }
  .letter-tile.is-valid-word { background: #d7f7d9; box-shadow: inset 0 -5px 0 #25a457, 3px 3px 0 #58795a; }
  .letter-tile.is-invalid-word { background: #ffe0da; box-shadow: inset 0 -5px 0 #d84b36, 3px 3px 0 #8b5d54; }
  .letter-tile.is-selected { outline-color: var(--tr-coral); }
  .letter-tile.is-dragging { cursor: grabbing; transform: rotate(4deg) scale(1.04); }
  .tile-drag-overlay { z-index: 200; }
  .rack-wrap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .55rem; align-items: center; min-height: 76px; padding: .42rem max(.6rem, env(safe-area-inset-right)) max(.42rem, env(safe-area-inset-bottom)) max(.6rem, env(safe-area-inset-left)); border-top: 2px solid var(--tr-ink); background: #2c2921; color: white; }
  .rack { min-height: 40px; display: flex; flex-wrap: wrap; align-content: center; gap: .28rem; }
  .review-dialog { width: min(700px, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: auto; border: 3px solid var(--tr-ink); border-radius: 18px; background: var(--tr-cream); color: var(--tr-ink); padding: 1.4rem; box-shadow: 9px 9px 0 var(--tr-ink); }
  .nearby-dialog { width: min(520px, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: auto; border: 3px solid var(--tr-ink); border-radius: 18px; background: var(--tr-cream); color: var(--tr-ink); padding: 1.4rem; box-shadow: 9px 9px 0 var(--tr-ink); }
  .nearby-dialog::backdrop { background: rgba(23,21,15,.65); backdrop-filter: blur(4px); }
  .nearby-dialog h2 { margin: 0 0 .5rem; font: 900 2rem/1 Georgia, serif; }
  .dialog-close { position: absolute; top: .6rem; right: .7rem; border: 0; background: transparent; color: var(--tr-ink); font-size: 1.7rem; cursor: pointer; }
  .nearby-endpoints { display: grid; gap: .5rem; margin-top: 1rem; }
  .nearby-endpoints button { padding: .8rem; border: 2px solid var(--tr-ink); border-radius: 9px; background: var(--tr-yellow); color: var(--tr-ink); font-weight: 800; cursor: pointer; }
  .nearby-verification { margin-top: 1rem; padding: 1rem; border: 2px solid var(--tr-ink); border-radius: 10px; background: #fff; text-align: center; }
  .nearby-verification strong { display: block; margin: .6rem; font: 900 2rem/1 ui-monospace, monospace; letter-spacing: .15em; }
  .nearby-verification > div { display: flex; justify-content: center; gap: .5rem; }
  .review-dialog::backdrop { background: rgba(23,21,15,.65); backdrop-filter: blur(4px); }
  .review-dialog h2 { margin: 0; font: 900 2.4rem/1 Georgia, serif; }
  .review-board { display: grid; grid-auto-columns: 28px; grid-auto-rows: 28px; justify-content: center; margin: 1rem auto; overflow: auto; }
  .review-board span { display: grid; place-items: center; border: 1px solid var(--tr-ink); background: white; font: 800 1rem/1 Georgia, serif; }
  .review-actions { display: flex; justify-content: flex-end; gap: .7rem; }
  .review-actions button { padding: .6rem .9rem; cursor: pointer; }
  .review-actions .rotten { background: var(--tr-coral); color: #fff; }
  .review-actions .accept { background: #a9f0bd; color: var(--tr-ink); }
  .update-notice { position: fixed; z-index: 300; top: max(.75rem, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: .75rem; width: max-content; max-width: calc(100vw - 1.5rem); padding: .6rem .65rem .6rem .9rem; border: 2px solid var(--tr-ink); border-radius: 11px; background: #fffdf3; color: var(--tr-ink); box-shadow: 4px 4px 0 var(--tr-ink); font-size: .9rem; font-weight: 800; }
  .update-notice[hidden] { display: none; }
  .update-notice button { flex: 0 0 auto; min-height: 2.5rem; padding: .55rem .75rem; border: 2px solid var(--tr-ink); border-radius: 8px; background: var(--tr-yellow); color: var(--tr-ink); font: 800 .85rem/1 inherit; cursor: pointer; }
  .toast { position: fixed; left: 50%; bottom: 1.5rem; transform: translate(-50%, 1rem); z-index: 100; max-width: calc(100vw - 2rem); padding: .8rem 1rem; border: 2px solid var(--tr-ink); border-radius: 9px; background: #fff4bd; color: var(--tr-ink) !important; box-shadow: 4px 4px 0 var(--tr-ink); font-weight: 800; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .18s ease, transform .18s ease, visibility 0s linear .18s; }
  .toast.is-visible { transform: translate(-50%, 0); opacity: 1; visibility: visible; transition-delay: 0s; }
  .toast[data-tone='good'] { background: #b9f5c8; }
  .toast[data-tone='bad'] { background: #ff9d8d; }
  .toast[data-tone='plain'] { background: #fff4bd; color: var(--tr-ink) !important; }
  .game-credit { display: none; }
  .game-credit a { color: var(--accent); }
  @media (max-width: 700px) {
    .entry-card, .lobby-card { width: calc(100% - 1.25rem); margin: max(.625rem, env(safe-area-inset-top)) auto max(.625rem, env(safe-area-inset-bottom)); padding: 1.25rem; border-radius: 16px; box-shadow: 5px 5px 0 var(--tr-ink); }
    .brand-mark { margin-bottom: 1rem; }
    .intro { margin: .85rem 0; font-size: 1rem; }
    .name-row { grid-template-columns: 1fr; }
    .lobby-card header { align-items: flex-start; }
    .roster { margin: 1.25rem 0; }
    .dictionary-picker { grid-template-columns: 1fr; gap: .35rem; }
    .lobby-invite { grid-template-columns: minmax(0, 1fr); justify-items: center; gap: .75rem; padding: .85rem; text-align: center; }
    .qr-frame canvas { width: 132px; height: 132px; }
    .invite-copy { width: 100%; min-width: 0; }
    .invite-copy h2 { font-size: 1.45rem; }
